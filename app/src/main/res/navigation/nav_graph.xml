<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.dicodingevent.ui.HomeFragment"
        tools:layout="@layout/fragment_home"
        android:label="Home" />

    <fragment
        android:id="@+id/navigation_active"
        android:name="com.example.dicodingevent.ui.ActiveEventFragment"
        tools:layout="@layout/fragment_active_event"
        android:label="Active Events" />

    <fragment
        android:id="@+id/navigation_finished"
        android:name="com.example.dicodingevent.ui.FinishedEventFragment"
        tools:layout="@layout/fragment_finished_event"
        android:label="Finished Events" />

    <fragment
        android:id="@+id/navigation_favorite"
        android:name="com.example.dicodingevent.ui.FavoriteFragment"
        android:label="Favorite"
        tools:layout="@layout/fragment_favorite" />

    <fragment
        android:id="@+id/navigation_setting"
        android:name="com.example.dicodingevent.ui.SettingFragment"
        android:label="Setting"
        tools:layout="@layout/fragment_setting" />

    <fragment
        android:id="@+id/navigation_detail"
        android:name="com.example.dicodingevent.ui.DetailFragment"
        android:label="Detail Event"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="eventId"
            app:argType="string" />
    </fragment>
</navigation>